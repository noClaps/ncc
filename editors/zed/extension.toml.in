id = "nc"
name = "NC"
version = "0.1.0"
schema_version = 1
description = "NC syntax highlighting and ncc language server"
authors = []

[grammars.nc]
repository = @REPOSITORY@
rev = @REVISION@
path = "tree-sitter-nc"

[language_servers.ncc]
languages = ["NC"]

[language_servers.ncc.language_ids]
NC = "nc"
