# Normalise line endings to LF. The compiler, the tests and their expected output files
# (`*.out`, `*.errors`, tree-sitter corpus files) all assume LF.
* text=auto eol=lf

# Binary files
*.wasm binary

# Generated by `tree-sitter generate`: collapsed in diffs and excluded from language stats
tooling/tree-sitter-nc/src/** linguist-generated
Cargo.lock linguist-generated

# GitHub Linguist maps `.nc` to nesC. NC is not a language Linguist knows, so leave these
# files out of the language stats instead of reporting them as nesC.
*.nc linguist-detectable=false
